# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco relacional local
DATABASE_URL=sqlite:///./app.db

# Provedor de geração: openai | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434/v1

# Provedor de embeddings: ollama | openai
# Um índice criado com um provedor/modelo/dimensão nunca deve ser misturado com outro.
# Padrão: Ollama local (instale em https://ollama.com e rode: ollama pull qwen3-embedding:0.6b).
# Para a OpenAI: EMBEDDING_PROVIDER=openai e EMBEDDING_MODEL=text-embedding-3-small.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
# Em CPU, lotes pequenos rendem melhor (4). Com GPU ou na OpenAI, pode subir para 32 ou mais.
EMBEDDING_BATCH_SIZE=4
# Em um servidor compartilhado, use uma pausa (por exemplo 10) entre os lotes.
EMBEDDING_PAUSE_SECONDS=0

# Cenário ativo: rj | saude | pesquisa
SCENARIO=rj

# Login do console (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logs estruturados (JSONL)
LOG_DIR=logs
